    <script>
        // ============================================================
        // TOASTS
        // ============================================================
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // ============================================================
        // TABS
        // ============================================================
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelector(`.tab[data-tab="${tab}"]`).classList.add('active');
            document.getElementById(`tab-${tab}`).classList.add('active');
            
            if (tab === 'users') { loadUsers(); loadUserStats(); }
            if (tab === 'integration') { loadTableStatus(); }
            if (tab === 'plans') { loadPackages(); loadStats(); }
        }

        // ============================================================
        // MODALS
        // ============================================================
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        // ============================================================
        // LOGS SSE
        // ============================================================
        let logCount = 0;
        let eventSource = null;

        function connectLogs() {
            try {
                eventSource = new EventSource('/api/logs/stream');
                eventSource.onmessage = function(event) {
                    try {
                        const log = JSON.parse(event.data);
                        addLogToUI(log);
                    } catch (e) {}
                };
                eventSource.onerror = function() { setTimeout(connectLogs, 3000); };
            } catch (error) { setTimeout(connectLogs, 5000); }
        }

        function addLogToUI(log) {
            const container = document.getElementById('logsContainer');
            if (container.querySelector('.empty-state')) {
                container.innerHTML = '';
            }
            const time = new Date(log.timestamp).toLocaleTimeString('pt-BR');
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.innerHTML = `
                <span class="log-time">${time}</span>
                <span class="log-type ${log.type || 'info'}">${(log.type || 'info').toUpperCase()}</span>
                <span>${log.message}</span>
            `;
            container.appendChild(entry);
            container.scrollTop = container.scrollHeight;
            logCount++;
            document.getElementById('logCount').textContent = logCount + ' logs';
            while (container.children.length > 200) {
                container.removeChild(container.firstChild);
            }
        }

        function clearLogs() {
            const container = document.getElementById('logsContainer');
            container.innerHTML = '<div style="color: #484f58; text-align: center; padding: 20px;">🔄 Aguardando logs...</div>';
            logCount = 0;
            document.getElementById('logCount').textContent = '0 logs';
            fetch('/api/logs/clear', { method: 'DELETE' });
        }

        // ============================================================
        // STATUS
        // ============================================================
        function updateStatus(connected, message, detail) {
            const bar = document.getElementById('statusBar');
            const dot = document.getElementById('statusDot');
            const text = document.getElementById('statusText');
            const detailEl = document.getElementById('statusDetail');

            bar.className = 'status-bar' + (connected ? ' connected' : '');
            dot.className = 'status-dot ' + (connected ? 'online' : 'offline');
            text.className = 'status-text ' + (connected ? 'online' : 'offline');
            text.textContent = message;
            detailEl.textContent = detail || '';
        }

        function checkConnection() {
            showToast('🔍 Verificando conexão...', 'info');
            fetch('/api/status')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.data.connected) {
                        updateStatus(true, '✅ Conectado', data.data.url || '');
                        showToast('✅ Conexão OK!', 'success');
                    } else {
                        updateStatus(false, '❌ Desconectado', data.data.error || '');
                        showToast('❌ Falha na conexão', 'error');
                    }
                })
                .catch(() => {
                    updateStatus(false, '❌ Erro', '');
                    showToast('❌ Erro ao verificar', 'error');
                });
        }

        // ============================================================
        // API CALLS
        // ============================================================
        async function apiCall(endpoint, method = 'GET', body = null) {
            const options = { method, headers: { 'Content-Type': 'application/json' } };
            if (body) options.body = JSON.stringify(body);
            try {
                const response = await fetch(endpoint, options);
                const data = await response.json();
                return { status: response.status, ok: response.ok, data };
            } catch (error) {
                return { status: 0, ok: false, data: { error: error.message } };
            }
        }

        function copyTextFrom(text) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast('✅ ID copiado: ' + text.substring(0,12) + '...', 'success');
                });
            } else {
                const input = document.createElement('input');
                input.value = text;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                showToast('✅ ID copiado', 'success');
            }
        }

        function showResponse(elementId, data, status) {
            const el = document.getElementById(elementId);
            el.className = 'response-body show';
            el.textContent = JSON.stringify(data, null, 2);
        }

        function hideResponse(elementId) {
            const el = document.getElementById(elementId);
            el.className = 'response-body';
            el.textContent = '';
        }

        // ============================================================
        // FUNÇÕES DE PLANOS
        // ============================================================
        async function seedPlans() {
            if (!confirm('📦 Inserir todos os planos predefinidos?')) return;
            showToast('📦 Inserindo planos...', 'info');
            const result = await apiCall('/api/packages/seed', 'POST');
            showResponse('actionResponse', result.data, result.status);
            if (result.ok) {
                showToast('✅ Planos inseridos!', 'success');
                loadPackages();
                loadStats();
            } else {
                showToast('❌ Erro: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        async function clearPlans() {
            if (!confirm('⚠️ Isso vai REMOVER TODOS os planos do banco. Continuar?')) return;
            showToast('🗑️ Removendo planos...', 'warning');
            const result = await apiCall('/api/packages/clear', 'DELETE');
            showResponse('actionResponse', result.data, result.status);
            if (result.ok) {
                showToast('✅ Planos removidos!', 'success');
                loadPackages();
                loadStats();
            } else {
                showToast('❌ Erro: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        async function resetPlans() {
            if (!confirm('⚠️ Isso vai LIMPAR e REINSERIR todos os planos. Continuar?')) return;
            showToast('🔄 Resetando planos...', 'warning');
            const result = await apiCall('/api/packages/reset', 'POST');
            showResponse('actionResponse', result.data, result.status);
            if (result.ok) {
                showToast('✅ Reset completo!', 'success');
                loadPackages();
                loadStats();
            } else {
                showToast('❌ Erro: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        async function loadPackages() {
            const result = await apiCall('/api/packages');
            const container = document.getElementById('dbPlansList');
            if (!result.ok) {
                container.innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }
            const data = result.data.data;
            if (!data || data.length === 0) {
                container.innerHTML = `<div class="empty-state"><div class="icon">📦</div><h3>Nenhum plano no banco</h3><p>Clique em "Inserir Planos" para criar</p></div>`;
                document.getElementById('packageCount').textContent = '0';
                return;
            }
            let html = `<div class="table-wrapper"><table class="table">
                <thead><tr>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Tipo</th>
                    <th>Tier</th>
                    <th>Créditos</th>
                    <th>ID</th>
                </tr></thead><tbody>`;
            data.forEach(p => {
                html += `<tr>
                    <td><strong>${p.name}</strong></td>
                    <td>$${p.price}</td>
                    <td>${p.billing_type || 'N/A'}</td>
                    <td><span class="badge badge-tier-${p.template_tier}">${p.template_tier}</span></td>
                    <td>${p.credit_amount || 0}</td>
                    <td><span class="clickable-id" onclick="copyTextFrom('${p.id}')">${p.id.substring(0,8)}...</span></td>
                </tr>`;
            });
            html += '</tbody></table></div>';
            container.innerHTML = html;
            document.getElementById('packageCount').textContent = data.length;
        }

        // ============================================================
        // FUNÇÕES DE USUÁRIOS
        // ============================================================
        let allUsers = [];

        async function loadUsers() {
            showToast('👥 Carregando usuários...', 'info');
            const result = await apiCall('/api/users');
            if (!result.ok) {
                document.getElementById('usersList').innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }
            allUsers = result.data.data.users || [];
            renderUsers(allUsers);
            document.getElementById('userListCount').textContent = allUsers.length + ' usuários';
            showToast(`✅ ${allUsers.length} usuários carregados`, 'success');
        }

        async function loadUsersWithPlans() {
            showToast('✅ Carregando usuários com planos...', 'info');
            const result = await apiCall('/api/users/with-plans');
            if (!result.ok) {
                document.getElementById('usersList').innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }
            const users = result.data.data.users || [];
            renderUsers(users.map(u => ({
                ...u,
                has_plan: true,
                user_id: u.user_id,
                email: u.email,
                full_name: u.full_name,
                company_name: u.company_name,
                subscription: u.plan
            })));
            document.getElementById('userListCount').textContent = users.length + ' usuários com planos';
            showToast(`✅ ${users.length} usuários com planos`, 'success');
        }

        async function loadUsersWithoutPlans() {
            showToast('❌ Carregando usuários sem planos...', 'info');
            const result = await apiCall('/api/users/without-plans');
            if (!result.ok) {
                document.getElementById('usersList').innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }
            const users = result.data.data.users || [];
            renderUsers(users.map(u => ({
                ...u,
                has_plan: false,
                user_id: u.user_id,
                email: u.email,
                full_name: u.full_name,
                company_name: u.company_name,
                subscription: null
            })));
            document.getElementById('userListCount').textContent = users.length + ' usuários sem planos';
            showToast(`✅ ${users.length} usuários sem planos`, 'success');
        }

        function renderUsers(users) {
            const container = document.getElementById('usersList');
            if (!users || users.length === 0) {
                container.innerHTML = `<div class="empty-state"><div class="icon">👥</div><h3>Nenhum usuário encontrado</h3></div>`;
                document.getElementById('filterCount').textContent = '';
                return;
            }

            let html = `<div class="table-wrapper"><table class="table">
                <thead><tr>
                    <th>Usuário</th>
                    <th>Email</th>
                    <th>Plano</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr></thead><tbody>`;

            users.forEach(u => {
                const hasPlan = u.has_plan || !!u.subscription;
                const planName = u.subscription?.package_name || u.plan?.name || 'Nenhum';
                const isTrial = u.subscription?.is_trial || u.plan?.is_trial || false;
                const isExpired = u.subscription?.status === 'inactive' || false;
                
                let statusClass = 'inactive';
                let statusText = '❌ Sem plano';
                if (hasPlan && isTrial) { statusClass = 'trial'; statusText = '🔬 Trial'; }
                else if (hasPlan && isExpired) { statusClass = 'expired'; statusText = '⏰ Expirado'; }
                else if (hasPlan) { statusClass = 'active'; statusText = '✅ Ativo'; }

                html += `
                    <tr onclick="showUserDetails('${u.user_id}')" style="cursor:pointer;">
                        <td><strong>${u.full_name || 'N/A'}</strong></td>
                        <td style="color:#8b949e; font-size:12px;">${u.email || 'N/A'}</td>
                        <td>${planName}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>
                            ${hasPlan ? 
                                `<button class="btn btn-danger btn-sm" onclick="event.stopPropagation(); openRevokeModal('${u.user_id}')">🚫 Revogar</button>` :
                                `<button class="btn btn-success btn-sm" onclick="event.stopPropagation(); openAssignUser('${u.user_id}')">📦 Atribuir</button>`
                            }
                            <button class="btn btn-outline btn-sm" onclick="event.stopPropagation(); copyTextFrom('${u.user_id}')">📋 ID</button>
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';
            container.innerHTML = html;
            document.getElementById('filterCount').textContent = users.length + ' encontrados';
        }

        function filterUsers() {
            const search = document.getElementById('userSearch').value.toLowerCase();
            const filtered = allUsers.filter(u => {
                const email = (u.email || '').toLowerCase();
                const name = (u.full_name || '').toLowerCase();
                return email.includes(search) || name.includes(search);
            });
            renderUsers(filtered);
            document.getElementById('userListCount').textContent = allUsers.length + ' usuários';
        }

        async function showUserDetails(userId) {
            showToast(`👤 Carregando detalhes do usuário...`, 'info');
            const result = await apiCall(`/api/users/${userId}/plan`);
            const container = document.getElementById('userDetails');
            
            if (!result.ok) {
                container.innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }

            const data = result.data.data;
            const hasPlan = data.has_plan;
            
            container.innerHTML = `
                <div style="background:#0d1117; border-radius:8px; padding:16px; border:1px solid #21262d;">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                        <div>
                            <h3 style="color:#e6edf3;">${data.user.full_name || 'N/A'}</h3>
                            <p style="color:#8b949e; font-size:13px;">${data.user.email}</p>
                            <p style="color:#484f58; font-size:12px;">ID: ${data.user.id}</p>
                        </div>
                        <div>
                            <span class="badge ${hasPlan ? 'badge-has-plan' : 'badge-no-plan'}">
                                ${hasPlan ? '✅ Com plano' : '❌ Sem plano'}
                            </span>
                        </div>
                    </div>
                    ${hasPlan ? `
                        <div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d;">
                            <div class="grid" style="grid-template-columns:1fr 1fr; gap:8px;">
                                <div><strong>Plano:</strong> ${data.subscription.package_name}</div>
                                <div><strong>Preço:</strong> $${data.subscription.package_price}</div>
                                <div><strong>Tier:</strong> ${data.subscription.template_tier}</div>
                                <div><strong>Tipo:</strong> ${data.subscription.billing_type}</div>
                                <div><strong>Expira:</strong> ${data.subscription.expiry_date ? new Date(data.subscription.expiry_date).toLocaleDateString() : 'N/A'}</div>
                                <div><strong>Trial:</strong> ${data.subscription.is_trial ? '🔬 Sim' : '❌ Não'}</div>
                            </div>
                        </div>
                    ` : `
                        <div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d;">
                            <p style="color:#8b949e;">Usuário não possui plano ativo.</p>
                            <button class="btn btn-success btn-sm" onclick="openAssignUser('${data.user.id}')">📦 Atribuir Plano</button>
                        </div>
                    `}
                    <div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d;">
                        <p><strong>Carteira:</strong></p>
                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-top:4px;">
                            <div style="background:#0d1117; padding:8px; border-radius:4px; border:1px solid #21262d; text-align:center;">
                                <span style="color:#8b949e; font-size:11px;">Invoices</span>
                                <div style="font-weight:bold; color:#58a6ff;">${data.wallet.invoice_remaining} ${data.wallet.invoice_unlimited ? '♾️' : ''}</div>
                            </div>
                            <div style="background:#0d1117; padding:8px; border-radius:4px; border:1px solid #21262d; text-align:center;">
                                <span style="color:#8b949e; font-size:11px;">Estimates</span>
                                <div style="font-weight:bold; color:#3fb950;">${data.wallet.estimate_remaining} ${data.wallet.estimate_unlimited ? '♾️' : ''}</div>
                            </div>
                            <div style="background:#0d1117; padding:8px; border-radius:4px; border:1px solid #21262d; text-align:center;">
                                <span style="color:#8b949e; font-size:11px;">AI Estimates</span>
                                <div style="font-weight:bold; color:#e3b341;">${data.wallet.ai_estimate_remaining} ${data.wallet.ai_estimate_unlimited ? '♾️' : ''}</div>
                            </div>
                        </div>
                    </div>
                    <div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d; font-size:12px; color:#8b949e;">
                        <span class="integration-badge success">✅ user_subscriptions</span>
                        <span class="integration-badge success">✅ wallets</span>
                        <span class="integration-badge payment">💳 payment_transactions</span>
                    </div>
                </div>
            `;
            
            showToast(`✅ Detalhes do usuário carregados`, 'success');
        }

        // ============================================================
        // ASSIGN PLAN
        // ============================================================
        function openAssignModal() {
            document.getElementById('assignUserId').value = '';
            document.getElementById('assignPackageId').value = '';
            document.getElementById('assignAmount').value = '';
            document.getElementById('assignCoupon').value = '';
            hideResponse('assignResponse');
            openModal('assignModal');
        }

        function openAssignUser(userId) {
            document.getElementById('assignUserId').value = userId;
            document.getElementById('assignPackageId').value = '';
            document.getElementById('assignAmount').value = '';
            document.getElementById('assignCoupon').value = '';
            hideResponse('assignResponse');
            openModal('assignModal');
        }

        async function assignPlan() {
            const userId = document.getElementById('assignUserId').value.trim();
            const packageId = document.getElementById('assignPackageId').value.trim();
            const billingType = document.getElementById('assignBillingType').value;
            const amount = document.getElementById('assignAmount').value.trim();
            const coupon = document.getElementById('assignCoupon').value.trim();

            if (!userId || !packageId) {
                showToast('❌ Preencha User ID e Package ID', 'error');
                return;
            }

            const body = { user_id: userId, package_id: packageId, billing_type: billingType };
            if (amount) body.amount = parseFloat(amount);
            if (coupon) body.coupon_code = coupon;

            showToast('📦 Atribuindo plano...', 'info');
            const result = await apiCall('/api/assign-plan', 'POST', body);
            showResponse('assignResponse', result.data, result.status);
            
            if (result.ok) {
                showToast('✅ Plano atribuído com sucesso!', 'success');
                const data = result.data.data;
                if (data && data.integration) {
                    showToast(`📊 ${data.integration.tables_updated.length} tabelas atualizadas`, 'info');
                }
                setTimeout(() => {
                    closeModal('assignModal');
                    loadUsers();
                    loadUserStats();
                    loadTableStatus();
                }, 1500);
            } else {
                showToast('❌ Erro: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        // ============================================================
        // REVOKE PLAN
        // ============================================================
        let revokeUserId = null;

        function openRevokeModal(userId) {
            revokeUserId = userId;
            document.getElementById('revokeReason').value = '';
            hideResponse('revokeResponse');
            openModal('revokeModal');
        }

        async function confirmRevoke() {
            if (!revokeUserId) {
                showToast('❌ Nenhum usuário selecionado', 'error');
                return;
            }

            const reason = document.getElementById('revokeReason').value.trim() || 'Revogado manualmente';

            showToast('🚫 Revogando plano...', 'warning');
            const result = await apiCall(`/api/users/${revokeUserId}/revoke-plan`, 'POST', { reason });
            showResponse('revokeResponse', result.data, result.status);
            
            if (result.ok) {
                showToast('✅ Plano revogado com sucesso!', 'success');
                setTimeout(() => {
                    closeModal('revokeModal');
                    loadUsers();
                    loadUserStats();
                    loadTableStatus();
                }, 1500);
            } else {
                showToast('❌ Erro: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        // ============================================================
        // ATIVAR PLANO DIRETO
        // ============================================================
        async function activatePlan() {
            const userId = document.getElementById('activateUserId').value.trim();
            const packageId = document.getElementById('activatePackageId').value.trim();
            const billingType = document.getElementById('activateBillingType').value;
            const days = parseInt(document.getElementById('activateDays').value) || 30;

            if (!userId || !packageId) {
                showToast('❌ Preencha User ID e Package ID', 'error');
                return;
            }

            showToast('⚡ Ativando plano...', 'info');
            
            try {
                const result = await apiCall('/api/activate-plan', 'POST', {
                    user_id: userId,
                    package_id: packageId,
                    billing_type: billingType,
                    days: days
                });

                const container = document.getElementById('activateResponse');
                container.className = 'response-body show';
                
                if (result.ok && result.data.success) {
                    const data = result.data.data;
                    container.innerHTML = `
✅ Plano ativado com sucesso!

👤 Usuário: ${data.user.full_name} (${data.user.email})
📦 Plano: ${data.plan.name} - $${data.plan.price}
📅 Expira em: ${data.days} dias (${new Date(data.expires_at).toLocaleDateString()})
💰 Créditos adicionados: ${data.credits_added}

📊 Wallet:
  • Invoices: ${data.wallet.invoice_remaining} ${data.wallet.invoice_unlimited ? '♾️' : ''}
  • Estimates: ${data.wallet.estimate_remaining} ${data.wallet.estimate_unlimited ? '♾️' : ''}
  • AI Estimates: ${data.wallet.ai_estimate_remaining} ${data.wallet.ai_estimate_unlimited ? '♾️' : ''}
                    `;
                    showToast('✅ Plano ativado com sucesso!', 'success');
                    
                    setTimeout(() => {
                        loadUsers();
                        loadUserStats();
                        loadTableStatus();
                    }, 1000);
                } else {
                    container.innerHTML = `❌ Erro: ${result.data.error || 'Erro ao ativar plano'}`;
                    showToast('❌ Erro ao ativar plano', 'error');
                }
            } catch (error) {
                const container = document.getElementById('activateResponse');
                container.className = 'response-body show';
                container.innerHTML = `❌ Erro: ${error.message}`;
                showToast('❌ Erro ao ativar plano', 'error');
            }
        }

        // ============================================================
        // ESTATÍSTICAS DE USUÁRIOS
        // ============================================================
        async function loadUserStats() {
            const result = await apiCall('/api/users/stats');
            const container = document.getElementById('userStatsDisplay');
            
            if (!result.ok) {
                container.innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${result.data.error || 'Erro'}</p></div>`;
                return;
            }

            const stats = result.data.data;
            const planDist = stats.plan_distribution || {};
            let planHtml = '';
            for (const [name, count] of Object.entries(planDist)) {
                planHtml += `<div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px solid #21262d;">
                    <span>${name}</span>
                    <span style="color:#58a6ff;">${count}</span>
                </div>`;
            }

            container.innerHTML = `
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
                    <div style="background:#0d1117; padding:12px; border-radius:8px; border:1px solid #21262d; text-align:center;">
                        <div style="font-size:24px; font-weight:bold; color:#58a6ff;">${stats.total_users}</div>
                        <div style="font-size:12px; color:#8b949e;">👥 Total</div>
                    </div>
                    <div style="background:#0d1117; padding:12px; border-radius:8px; border:1px solid #21262d; text-align:center;">
                        <div style="font-size:24px; font-weight:bold; color:#3fb950;">${stats.users_with_plans}</div>
                        <div style="font-size:12px; color:#8b949e;">✅ Com Plano</div>
                    </div>
                    <div style="background:#0d1117; padding:12px; border-radius:8px; border:1px solid #21262d; text-align:center;">
                        <div style="font-size:24px; font-weight:bold; color:#f85149;">${stats.users_without_plans}</div>
                        <div style="font-size:12px; color:#8b949e;">❌ Sem Plano</div>
                    </div>
                </div>
                ${planHtml ? `
                    <div style="padding-top:12px; border-top:1px solid #21262d;">
                        <p style="color:#8b949e; font-size:13px; margin-bottom:8px;">📊 Distribuição por Plano</p>
                        ${planHtml}
                    </div>
                ` : ''}
                <div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d; font-size:12px; color:#8b949e;">
                    📊 Taxa de Conversão: <strong>${stats.conversion_rate || '0%'}</strong>
                </div>
            `;

            document.getElementById('userCount').textContent = stats.total_users;
            document.getElementById('subCount').textContent = stats.users_with_plans;
            document.getElementById('creditCount').textContent = stats.credits ? 
                stats.credits.total_invoice_credits + stats.credits.total_estimate_credits + stats.credits.total_ai_credits : 0;
        }

        // ============================================================
        // ESTATÍSTICAS GERAIS
        // ============================================================
        async function loadStats() {
            const result = await apiCall('/api/stats');
            if (!result.ok) {
                document.getElementById('statsDisplay').innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro</p></div>`;
                return;
            }
            const stats = result.data.data;
            document.getElementById('statsDisplay').innerHTML = `
                <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:12px;">
                    <div style="background:#0d1117; padding:12px; border-radius:8px; text-align:center; border:1px solid #21262d;">
                        <div style="font-size:24px; font-weight:bold; color:#58a6ff;">${stats.packages || 0}</div>
                        <div style="font-size:12px; color:#8b949e;">📦 Planos</div>
                    </div>
                    <div style="background:#0d1117; padding:12px; border-radius:8px; text-align:center; border:1px solid #21262d;">
                        <div style="font-size:24px; font-weight:bold; color:#3fb950;">${stats.subscriptions || 0}</div>
                        <div style="font-size:12px; color:#8b949e;">📄 Assinaturas</div>
                    </div>
                    <div style="background:#0d1117; padding:12px; border-radius:8px; text-align:center; border:1px solid #21262d;">
                        <div style="font-size:24px; font-weight:bold; color:#e3b341;">${stats.wallets || 0}</div>
                        <div style="font-size:12px; color:#8b949e;">👛 Carteiras</div>
                    </div>
                    <div style="background:#0d1117; padding:12px; border-radius:8px; text-align:center; border:1px solid #21262d;">
                        <div style="font-size:24px; font-weight:bold; color:#bc8cff;">${stats.coupons || 0}</div>
                        <div style="font-size:12px; color:#8b949e;">🏷️ Cupons</div>
                    </div>
                </div>
            `;
            document.getElementById('couponCount').textContent = stats.coupons || 0;
        }

        // ============================================================
        // TABELA STATUS
        // ============================================================
        async function loadTableStatus() {
            showToast('📊 Carregando status das tabelas...', 'info');
            const container = document.getElementById('tableStatus');
            
            try {
                const result = await apiCall('/api/stats');
                const stats = result.data.data || {};
                
                const tables = [
                    { name: 'subscription_plans', icon: '📦', color: '#58a6ff', count: stats.packages || 0 },
                    { name: 'user_subscriptions', icon: '📄', color: '#3fb950', count: stats.subscriptions || 0 },
                    { name: 'wallets', icon: '👛', color: '#e3b341', count: stats.wallets || 0 },
                    { name: 'profiles', icon: '👤', color: '#bc8cff', count: 'N/A' },
                ];

                let html = `<div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">`;
                tables.forEach(t => {
                    html += `
                        <div style="background:#0d1117; padding:12px; border-radius:8px; border:1px solid #21262d; display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <span style="font-size:16px;">${t.icon}</span>
                                <span style="font-size:13px; margin-left:8px;">${t.name}</span>
                            </div>
                            <span style="color:${t.color}; font-weight:bold; font-size:18px;">${t.count}</span>
                        </div>
                    `;
                });
                html += '</div>';
                html += `<div style="margin-top:12px; padding-top:12px; border-top:1px solid #21262d; font-size:12px; color:#8b949e;">
                    🔄 Última atualização: ${new Date().toLocaleTimeString()}
                </div>`;
                
                container.innerHTML = html;
                showToast('✅ Status das tabelas atualizado', 'success');
            } catch (error) {
                container.innerHTML = `<div class="empty-state"><div class="icon">❌</div><p style="color:#f85149;">Erro: ${error.message}</p></div>`;
                showToast('❌ Erro ao carregar status', 'error');
            }
        }

        // ============================================================
        // TESTE DE INTEGRAÇÃO
        // ============================================================
        async function testIntegration() {
            const userId = document.getElementById('testUserId').value.trim();
            const packageId = document.getElementById('testPackageId').value.trim();

            if (!userId || !packageId) {
                showToast('❌ Preencha User ID e Package ID', 'error');
                return;
            }

            showToast('🧪 Testando integração...', 'info');
            const result = await apiCall('/api/assign-plan', 'POST', {
                user_id: userId,
                package_id: packageId,
                billing_type: 'monthly'
            });

            showResponse('integrationResponse', result.data, result.status);
            
            if (result.ok && result.data.data) {
                const data = result.data.data;
                const integration = data.integration || {};
                
                let html = `✅ Integração concluída com sucesso!\n\n`;
                html += `📦 Plano: ${data.package.name}\n`;
                html += `👤 Usuário: ${data.user.name}\n`;
                html += `💰 Créditos adicionados: ${data.credits_added}\n\n`;
                html += `📊 Tabelas atualizadas:\n`;
                if (integration.tables_updated) {
                    integration.tables_updated.forEach(t => { html += `  ✅ ${t}\n`; });
                }
                html += `\n🔓 Recursos liberados:\n`;
                html += `  📄 Template Tier: ${integration.features_unlocked?.template_tier || 'basic'}\n`;
                html += `  🚀 Invoices Ilimitadas: ${integration.features_unlocked?.invoice_unlimited ? 'Sim' : 'Não'}\n`;
                html += `  🚀 Estimates Ilimitados: ${integration.features_unlocked?.estimate_unlimited ? 'Sim' : 'Não'}\n`;
                
                document.getElementById('integrationResponse').className = 'response-body show';
                document.getElementById('integrationResponse').textContent = html;
                
                showToast('✅ Teste de integração concluído!', 'success');
                loadTableStatus();
            } else {
                showToast('❌ Erro no teste: ' + (result.data.error || 'Erro'), 'error');
            }
        }

        // ============================================================
        // REFRESH
        // ============================================================
        async function refreshAll() {
            showToast('🔄 Recarregando...', 'info');
            await checkConnection();
            await loadPackages();
            await loadStats();
            await loadUsers();
            await loadUserStats();
            await loadTableStatus();
            showToast('✅ Recarregado!', 'success');
        }

        // ============================================================
        // INICIALIZAÇÃO
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            connectLogs();
            setTimeout(() => {
                checkConnection();
                loadPackages();
                loadStats();
                loadUsers();
                loadUserStats();
                loadTableStatus();
            }, 500);
        });
    </script>
</body>
</html>